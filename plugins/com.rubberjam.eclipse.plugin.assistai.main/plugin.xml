<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         id="com.rubberjam.eclipse.assistai.fragment"
         point="org.eclipse.e4.workbench.model">
      <fragment
            apply="always"
            uri="fragment.e4xmi">
      </fragment>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">

      <page
            class="com.rubberjam.eclipse.assistai.preferences.models.ModelPreferencePage"
            id="com.rubberjam.eclipse.assistai.preferences.OpenAIPreferencePage"
            name="AssistAI">
      </page>
        <page
            id="com.rubberjam.eclipse.assistai.preferences.PromptsPreferencePage"
            name="Prompts"
            category="com.rubberjam.eclipse.assistai.preferences.OpenAIPreferencePage"
            class="com.rubberjam.eclipse.assistai.preferences.prompts.PromptsPreferencePage">
        </page>
        <page
            id="com.rubberjam.eclipse.assistai.preferences.ModelListPreferencePage"
            name="Models"
            category="com.rubberjam.eclipse.assistai.preferences.OpenAIPreferencePage"
            class="com.rubberjam.eclipse.assistai.preferences.models.ModelListPreferencePage">
        </page>
        <page
            id="com.rubberjam.eclipse.assistai.preferences.McpServerPreferencePage"
            name="MCP Servers"
            category="com.rubberjam.eclipse.assistai.preferences.OpenAIPreferencePage"
            class="com.rubberjam.eclipse.assistai.preferences.mcp.McpServerPreferencePage">
        </page>
        <page
            id="com.rubberjam.eclipse.assistai.preferences.McpHttpServerPreferencePage"
            name="HTTP MCP Server"
            category="com.rubberjam.eclipse.assistai.preferences.OpenAIPreferencePage"
            class="com.rubberjam.eclipse.assistai.preferences.mcp.McpHttpServerPreferencePage">
        </page>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="com.rubberjam.eclipse.assistai.preferences.PreferenceInitializer">
      </initializer>
   </extension>
   <extension point="org.eclipse.ui.startup">
       <startup class="com.rubberjam.eclipse.assistai.PluginStartup"/>
   </extension>

   <!--
   AI Code Completion is available via Alt+/ hotkey only.
   We intentionally don't register with javaCompletionProposalComputer to avoid
   appearing in Ctrl+Space content assist (which would slow down the UI).
   -->

   <!-- Command for AI Code Completion -->
   <extension point="org.eclipse.ui.commands">
      <category
            id="com.rubberjam.eclipse.assistai.commands.category"
            name="AssistAI">
      </category>
      <command
            id="com.rubberjam.eclipse.assistai.commands.aiCompletion"
            name="AI Code Completion"
            description="Trigger AI-powered code completion"
            categoryId="com.rubberjam.eclipse.assistai.commands.category">
      </command>
      <command
            id="com.rubberjam.eclipse.assistai.commands.agentNewTab"
            name="New Agent Tab"
            description="Create a new agent chat tab"
            categoryId="com.rubberjam.eclipse.assistai.commands.category">
      </command>
      <command
            id="com.rubberjam.eclipse.assistai.commands.agentClearTab"
            name="Clear Agent Tab"
            description="Clear the current agent tab conversation"
            categoryId="com.rubberjam.eclipse.assistai.commands.category">
      </command>
      <command
            id="com.rubberjam.eclipse.assistai.commands.agentFocusView"
            name="Focus Agent View"
            description="Show and focus the AI Chat view"
            categoryId="com.rubberjam.eclipse.assistai.commands.category">
      </command>
      <command
            id="com.rubberjam.eclipse.assistai.commands.agentStop"
            name="Stop Agent"
            description="Stop the current agent generation"
            categoryId="com.rubberjam.eclipse.assistai.commands.category">
      </command>
   </extension>

   <!-- Handler for AI Code Completion Command -->
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.rubberjam.eclipse.assistai.commands.aiCompletion"
            class="com.rubberjam.eclipse.assistai.completion.AICompletionHandler">
      </handler>
      <handler
            commandId="com.rubberjam.eclipse.assistai.commands.agentNewTab"
            class="com.rubberjam.eclipse.assistai.handlers.AssistAIAgentNewTabHandler">
      </handler>
      <handler
            commandId="com.rubberjam.eclipse.assistai.commands.agentClearTab"
            class="com.rubberjam.eclipse.assistai.handlers.AssistAIAgentClearTabHandler">
      </handler>
      <handler
            commandId="com.rubberjam.eclipse.assistai.commands.agentFocusView"
            class="com.rubberjam.eclipse.assistai.handlers.AssistAIAgentFocusViewHandler">
      </handler>
      <handler
            commandId="com.rubberjam.eclipse.assistai.commands.agentStop"
            class="com.rubberjam.eclipse.assistai.handlers.AssistAIAgentStopHandler">
      </handler>
   </extension>

   <!-- Key Binding for AI Code Completion -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="com.rubberjam.eclipse.assistai.commands.aiCompletion"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Alt+/"
            contextId="org.eclipse.jdt.ui.javaEditorScope">
      </key>
      <key
            commandId="com.rubberjam.eclipse.plugin.assistai.main.command.addToResources"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Ctrl+Alt+A">
      </key>
      <key
            commandId="com.rubberjam.eclipse.assistai.commands.agentStop"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="Ctrl+Shift+S">
      </key>
   </extension>

</plugin>
